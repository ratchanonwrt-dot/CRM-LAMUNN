// Prisma schema — CRM Lamunn (21-branch loyalty points system)
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (port 6543, via Supabase's pgbouncer) — used at runtime.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — required for `prisma migrate` to work against Supabase.
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum StaffRole {
  SUPER_ADMIN // Manager — HQ, sees/manages all branches
  SUPERVISOR // ผู้ดูแลสาขา — manages own branch: staff, reports, redemption approval
  STAFF // front-of-store: lookup customers, manual point adjustments
  MARKETING // HQ, campaign content only: rewards + app settings (hero/tier images/copy)
}

enum Gender {
  FEMALE
  MALE
  LGBTQ
  UNSPECIFIED
}

enum TransactionType {
  EARN // points earned from a purchase (QR scan)
  REDEEM // points spent on a reward
  ADJUST // manual correction by admin/staff (can be + or -)
  VOID // reversal of a previous EARN (e.g. receipt refunded)
}

enum RedemptionStatus {
  PENDING // customer requested, awaiting in-store fulfillment
  COMPLETED
  CANCELLED
}

enum ScanResult {
  SUCCESS
  DUPLICATE // receipt already redeemed
  INVALID_SIGNATURE // HMAC signature from POS did not match
  INVALID_BRANCH // branch code not found / inactive
  EXPIRED // QR older than allowed window
  BILL_VOIDED // matching POS bill exists but is already void
  BILL_NOT_FOUND // no matching bill in the POS at all — signature was valid but POS has no record
  ERROR
}

// Single-row table (id is always "singleton") holding app-wide branding/config
// that the customer app reads and the admin app writes.
model AppSettings {
  id           String   @id @default("singleton")
  heroImageUrl String?
  logoImageUrl String? // shown on the customer app's landing page + login page; falls back to the bundled default logo when null

  // Editable customer-app copy — null means "use the built-in default text".
  appName             String?
  taglineTh           String?
  taglineEn           String?
  greetingMorningTh   String?
  greetingMorningEn   String?
  greetingAfternoonTh String?
  greetingAfternoonEn String?
  greetingEveningTh   String?
  greetingEveningEn   String?
  navHomeTh           String?
  navHomeEn           String?
  navRedeemTh         String?
  navRedeemEn         String?

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------- Core models ----------

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique // matches the branch code POS embeds in the QR, e.g. "BKK01"
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff        StaffUser[]
  pointRules   PointRule[]
  transactions PointTransaction[]
  redemptions  Redemption[]
  scanLogs     QrScanLog[]

  @@map("branches")
}

model StaffUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  employeeCode String? // same code this staff member uses to log into IMS, for cross-referencing
  role         StaffRole @default(STAFF)
  branchId     String? // null when role = SUPER_ADMIN
  branch       Branch?   @relation(fields: [branchId], references: [id])
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  processedTransactions PointTransaction[] @relation("ProcessedByStaff")
  fulfilledRedemptions  Redemption[]       @relation("FulfilledByStaff")
  auditLogs             AuditLog[]
  processedB2BPurchases B2BPurchase[]      @relation("ProcessedB2BPurchase")

  @@index([branchId])
  @@map("staff_users")
}

// Tracks who changed what across campaign-editable entities (rewards, membership
// tiers, app settings) so SUPER_ADMIN can review Marketing-team edits after the fact.
model AuditLog {
  id         String    @id @default(cuid())
  staffId    String
  staff      StaffUser @relation(fields: [staffId], references: [id])
  staffName  String
  staffRole  StaffRole
  action     String // "CREATE" | "UPDATE" | "DELETE"
  entityType String // "Reward" | "MembershipTier" | "AppSettings"
  entityId   String?
  summary    String
  changes    Json?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([staffId])
  @@map("audit_logs")
}

// Which nav pages/features each role can access, editable by SUPER_ADMIN from
// /admin/role-permissions. A missing row falls back to the hardcoded default in
// packages/db/src/permissions.ts. SUPER_ADMIN itself always has full access — it is
// never gated by this table, so an admin can never lock themselves out.
model RolePermission {
  id      String    @id @default(cuid())
  role    StaffRole
  feature String
  allowed Boolean   @default(true)

  @@unique([role, feature])
  @@map("role_permissions")
}

model Customer {
  id             String    @id @default(cuid())
  firstName      String?
  lastName       String?
  phone          String?   @unique
  lineUserId     String?   @unique
  email          String?
  dateOfBirth    DateTime?
  // Set the moment a customer confirms their date of birth (first entry, or the
  // one-time re-confirmation prompt) — once set, dateOfBirth can never be changed
  // by the customer again, only by staff, to stop birthday-month promo abuse.
  dateOfBirthConfirmedAt DateTime?
  gender         Gender?
  pdpaConsentedAt DateTime? // when the customer accepted the data-usage consent notice at signup
  tosConsentedAt DateTime? // when the customer accepted the Terms of Service at signup
  pointsBalance  Int       @default(0) // denormalized running balance, kept in sync in a DB transaction
  // Cumulative points ever earned (EARN + positive ADJUST) — only ever increases,
  // used as the ceiling a customer can be promoted up to (see currentTierId).
  lifetimePoints Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // The customer's actual displayed/effective tier — decoupled from lifetimePoints
  // because it can be demoted (lifetimePoints never decreases). Promotion is instant
  // whenever lifetimePoints crosses a new threshold; demotion only happens at the
  // 6-month anniversary maintenance check. See packages/db/src/tierLifecycle.ts.
  currentTierId String?
  currentTier   MembershipTier? @relation(fields: [currentTierId], references: [id])
  // Start of the customer's current 6-month tier cycle — reset every time their tier
  // changes (promotion, successful renewal, or demotion). Due for a maintenance
  // check once this is 6+ months old (Starbucks-Rewards-style anniversary window).
  tierAnniversaryAt DateTime?
  // Set the moment a customer is demoted for failing a maintenance check; while
  // set, instant lifetimePoints-based promotion is disabled for this customer —
  // otherwise they'd bounce straight back up on the very next cron run, since
  // lifetimePoints never decreases. Cleared once they re-qualify for a higher
  // tier the fair way, via renewed spend at an anniversary check.
  demotedAt DateTime?
  // Last time the quarterly tier-voucher bundle was granted; null = never.
  lastTierVoucherGrantAt DateTime?

  otpCodes     OtpCode[]
  transactions PointTransaction[]
  redemptions  Redemption[]

  @@map("customers")
}

// Membership tiers (Silver/Gold/Platinum, ...) unlocked by lifetime points earned.
// Editable via the back office: name, threshold, benefit text, and badge/card image.
model MembershipTier {
  id        String   @id @default(cuid())
  name      String
  minPoints Int
  benefit   String?
  imageUrl  String?
  sortOrder Int      @default(0)
  // Cumulative spend a customer must reach within their current 6-month
  // tierAnniversaryAt window to renew this tier — null means no maintenance
  // requirement (Bronze: always safe, never demoted below it).
  maintenanceSpendThreshold Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customersHere    Customer[]
  voucherTemplates TierVoucherTemplate[]

  @@map("membership_tiers")
}

// Recipe: "tier X grants N copies of voucher Y every 3-month cycle" — the cron
// job in tierLifecycle.ts reads these to build each customer's automatic grant.
model TierVoucherTemplate {
  id        String         @id @default(cuid())
  tierId    String
  tier      MembershipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  rewardId  String
  reward    Reward         @relation(fields: [rewardId], references: [id])
  quantity  Int // how many copies of this voucher are granted per cycle
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("tier_voucher_templates")
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  // Exactly one of these is set: codeHash for the local console-log dev
  // fallback (no SMS_API_KEY configured), token for the real Thaibulksms
  // OTP Console flow (they generate/verify the pin, we just hold their token).
  codeHash   String?
  token      String?
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  @@index([phone])
  @@map("otp_codes")
}

// Baht-to-point conversion rule. A null branchId means "default rule for all branches"
// that don't have their own override. Multiple rules per branch are allowed for
// time-boxed promotions (effectiveFrom/effectiveTo); the API picks the most specific
// active rule at redemption time.
model PointRule {
  id            String    @id @default(cuid())
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  name          String    @default("Default")
  bahtPerPoint  Decimal   @db.Decimal(10, 2) // e.g. 25.00 => every 25 THB spent = 1 point
  minAmount     Decimal   @default(0) @db.Decimal(10, 2)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([branchId])
  @@map("point_rules")
}

// Every earn/redeem/adjust/void is one row here — the ledger of truth.
// (branchId, receiptNo) is unique so the same POS receipt can never be redeemed twice.
// branchId is nullable because REDEEM/ADJUST rows aren't always tied to a specific
// branch (e.g. a reward redeemed centrally); Postgres treats NULLs as distinct in a
// unique index, so many null/null rows can coexist without colliding.
model PointTransaction {
  id                 String          @id @default(cuid())
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id])
  branchId           String?
  branch             Branch?         @relation(fields: [branchId], references: [id])
  type               TransactionType
  points             Int // positive for EARN/ADJUST(+), negative for REDEEM/VOID/ADJUST(-)
  amount             Decimal?        @db.Decimal(10, 2) // sale amount in THB, for EARN rows
  receiptNo          String? // POS receipt number, required for EARN via QR
  qrRawPayload       String? // raw string decoded from the QR, kept for audit
  note               String?
  processedByStaff   StaffUser?      @relation("ProcessedByStaff", fields: [processedByStaffId], references: [id])
  processedByStaffId String?
  createdAt          DateTime        @default(now())
  expiresAt          DateTime? // set only on EARN rows: createdAt + 1 year
  expired            Boolean         @default(false) // set once this EARN row has been auto-voided for expiry
  voidedInPos        Boolean         @default(false) // set once this EARN row has been auto-reversed because the POS bill was voided after the scan

  @@unique([branchId, receiptNo])
  @@index([customerId])
  @@map("point_transactions")
}

enum RewardKind {
  REWARD // shown in the customer app's catalog, self-service redeem with points
  VOUCHER // admin-only: keyed to a specific customer by phone from /admin/vouchers, never self-service
}

// Marks a voucher as the one auto-granted by a specific customer-lifecycle event
// (see packages/db/src/autoCoupons.ts). @unique so at most one active mapping can
// exist per trigger at a time — admin must clear the old one before reassigning.
enum RewardAutoTrigger {
  WELCOME // granted once, the first time a Customer row is created
  NEXT_PURCHASE // granted once a customer's WELCOME redemption is confirmed (COMPLETED)
  BIRTHDAY_MONTH // granted once per year when the current month matches Customer.dateOfBirth's month
}

model Reward {
  id                String     @id @default(cuid())
  kind              RewardKind @default(REWARD)
  name              String
  description       String?
  pointsCost        Int? // required for kind=REWARD, irrelevant (null) for kind=VOUCHER
  stock             Int? // null = unlimited
  imageUrl          String?
  discountPercent   Int? // e.g. 50 = "ลด 50%" — set only for discount-style vouchers
  discountMaxAmount Decimal?   @db.Decimal(10, 2) // e.g. 300 = "สูงสุด 300 บาท" — caps the discount above
  discountAmount    Decimal?   @db.Decimal(10, 2) // e.g. 20 = "ลด 20 บาท" — flat-amount alternative to discountPercent
  minSpendAmount    Decimal?   @db.Decimal(10, 2) // e.g. 200 = "ซื้อครบ 200 บาท" — display-only condition, staff apply it manually at the POS
  isActive          Boolean    @default(true)
  autoTrigger       RewardAutoTrigger? @unique // null = not an auto-granted coupon; see grantAutoCoupons in autoCoupons.ts
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  redemptions          Redemption[]
  tierVoucherTemplates TierVoucherTemplate[]

  @@map("rewards")
}

model Redemption {
  id                 String           @id @default(cuid())
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id])
  rewardId           String?
  reward             Reward?          @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  rewardName         String // snapshot of Reward.name at redemption time, so history/coupons still
  // read correctly after the catalog reward itself is deleted (rewardId goes null, this doesn't)
  pointsSpent        Int
  status             RedemptionStatus @default(PENDING)
  branchId           String?
  branch             Branch?          @relation(fields: [branchId], references: [id])
  fulfilledByStaff   StaffUser?       @relation("FulfilledByStaff", fields: [fulfilledByStaffId], references: [id])
  fulfilledByStaffId String?
  // POS bill number the staff member typed in at confirm time, for a free
  // (pointsSpent=0) voucher only — lets the per-transaction fraud check in
  // fraudCheck.ts look up that exact bill's real discount and catch a staff
  // member keying more discount into POS than the voucher actually allows.
  posBillNo          String?
  expiresAt          DateTime? // set only for granted vouchers with a deadline (see /admin/vouchers) — null means no expiry
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([customerId])
  @@map("redemptions")
}

// Audit trail of every QR scan attempt, success or not — used to spot forged/duplicate
// QR abuse across the 21 branches.
model QrScanLog {
  id             String     @id @default(cuid())
  rawPayload     String
  branchCode     String?
  branchId       String?
  branch         Branch?    @relation(fields: [branchId], references: [id])
  receiptNo      String?
  amount         Decimal?   @db.Decimal(10, 2)
  signatureValid Boolean
  result         ScanResult
  customerId     String?
  ip             String?
  userAgent      String?
  createdAt      DateTime   @default(now())

  @@index([branchId])
  @@index([receiptNo])
  @@map("qr_scan_logs")
}

// ---------- B2B / Catering membership ----------
// Deliberately separate from Customer/PointTransaction/MembershipTier above — a
// completely different program (cumulative THB spend -> a discount tier, entered
// entirely by staff) that must never mix with the retail walk-in CRM data.

model B2BCustomer {
  id          String   @id @default(cuid())
  companyName String
  contactName String?
  phone       String?
  email       String?
  note        String?
  totalSpend  Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases B2BPurchase[]

  @@map("b2b_customers")
}

model B2BTier {
  id              String   @id @default(cuid())
  name            String
  minSpend        Decimal  @db.Decimal(12, 2)
  discountPercent Int
  benefit         String? // free-text extra perks beyond the discount — priority support, free delivery, etc.
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("b2b_tiers")
}

model B2BPurchase {
  id                 String      @id @default(cuid())
  b2bCustomerId      String
  b2bCustomer        B2BCustomer @relation(fields: [b2bCustomerId], references: [id])
  amount             Decimal     @db.Decimal(12, 2)
  note               String?
  processedByStaff   StaffUser?  @relation("ProcessedB2BPurchase", fields: [processedByStaffId], references: [id])
  processedByStaffId String?
  createdAt          DateTime    @default(now())

  @@index([b2bCustomerId])
  @@map("b2b_purchases")
}
