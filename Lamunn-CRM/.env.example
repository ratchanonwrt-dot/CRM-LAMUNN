# ---------- Database (Supabase Postgres — same project as Lamunn-CRMAdmin) ----------
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---------- NextAuth (customer only — separate secret from Lamunn-CRMAdmin) ----------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ---------- LINE Login (customer auth) ----------
# Web-only for now — the login page only shows phone+OTP until this is turned on.
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
NEXT_PUBLIC_LINE_LOGIN_ENABLED="false"

# ---------- Phone OTP (customer auth) ----------
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SENDER_NAME="LAMUNN"
OTP_TTL_MINUTES="5"

# ---------- QR / POS integration ----------
# Must match the same value in Lamunn-CRMAdmin/.env — Admin signs QR codes
# (via "จำลอง QR"), this app verifies them at scan time.
POS_QR_SECRET="change-me-to-a-long-random-string"
QR_VALID_HOURS="72"
MAX_UNSIGNED_AUTO_POINTS_AMOUNT="2000"

# ---------- Cross-app link ----------
# Base URL of the back-office app (Lamunn-CRMAdmin) — used to build the QR link
# customers show staff to confirm a reward redemption.
ADMIN_APP_URL="http://localhost:3001"
