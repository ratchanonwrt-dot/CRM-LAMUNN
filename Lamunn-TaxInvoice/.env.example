# SQLite file DB, standalone from the other 2 Lamunn projects.
DATABASE_URL="file:./dev.db"

# --- POS QR cross-check ---
# Same signing scheme as Lamunn-CRM's loyalty QR (packages/db/src/qr.ts):
# https://<domain>/r?b=<branchCode>&r=<receiptNo>&a=<amount>&t=<unixSeconds>&s=<hmacSig>
# Must match whatever secret the POS is configured to sign with. Until the in-house
# POS project finishes wiring up signing, this can be left blank — unsigned QR codes
# are still accepted, capped by MAX_UNSIGNED_AUTO_AMOUNT below.
POS_QR_SECRET=""
QR_VALID_HOURS=72
MAX_UNSIGNED_AUTO_AMOUNT=0

# --- Flow Account (ออกใบกำกับภาษี) ---
# Fill in once available. See src/lib/flowaccount.ts — the exact endpoint/payload
# shape is marked TODO and should be double-checked against Flow Account's current
# Open API docs before going live. Until FLOWACCOUNT_API_KEY is set, requests are
# saved with status AWAITING_FLOWACCOUNT_SETUP instead of calling the API.
FLOWACCOUNT_API_KEY=""
FLOWACCOUNT_ACCOUNT_ID=""
FLOWACCOUNT_API_BASE_URL="https://api-openapi.flowaccount.com/v1"

# --- Resend (ส่งอีเมลใบกำกับภาษี) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ใบกำกับภาษี <invoice@yourdomain.com>"

# --- Internal admin list page ---
ADMIN_PASSWORD=""
